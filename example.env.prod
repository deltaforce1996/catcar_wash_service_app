# ===========================================
# CatCar Wash Service - Production Environment
# ===========================================
# Copy this file to .env.prod and fill in your actual values
# Usage: docker-compose --env-file .env.prod -f docker-compose.prod.yml up -d

# ===========================================
# Application Settings
# ===========================================

# Version number for Docker image tagging
# Used to tag backend and frontend images (e.g., catcar_wash_backend:1.0.0)
VERSION=1.0.0

# API route prefix (e.g., /api/v1/users)
# All backend endpoints will be prefixed with this value
API_PREFIX=api

# Application log level
# Options: error, warn, info, debug, verbose
LOG_LEVEL=info

# ===========================================
# PostgreSQL Database
# ===========================================

# Database name to create and connect to
POSTGRES_DB=catcar_wash_db

# Database username for authentication
POSTGRES_USER=catcar_user

# Database password - CHANGE THIS!
# Use a strong password with mix of uppercase, lowercase, numbers, and symbols
# Minimum 16 characters recommended
POSTGRES_PASSWORD=your-strong-postgres-password-here

# ===========================================
# pgAdmin (Database Management UI)
# ===========================================
# Web-based PostgreSQL management tool
# Access at: http://your-server:8080

# Login email for pgAdmin web interface
PGADMIN_EMAIL=admin@example.com

# Login password for pgAdmin web interface - CHANGE THIS!
PGADMIN_PASSWORD=your-strong-pgadmin-password-here

# ===========================================
# EMQX MQTT Broker
# ===========================================
# Message broker for device communication
# Dashboard access at: http://localhost:18083 (localhost only for security)
# MQTT TCP port: 1883
# MQTT WebSocket port: 8083

# Username for EMQX dashboard login
EMQX_DASHBOARD_USER=admin

# Password for EMQX dashboard login - CHANGE THIS!
EMQX_DASHBOARD_PASSWORD=your-strong-emqx-password-here

# ===========================================
# JWT Authentication
# ===========================================
# JSON Web Token settings for user authentication

# Secret key for signing JWT tokens - CHANGE THIS!
# Generate a strong secret using: openssl rand -base64 64
# This should be at least 64 characters long
# IMPORTANT: Keep this secret and never commit to version control
JWT_SECRET=your-very-long-and-secure-jwt-secret-key-here

# Token expiration time
# Format: number + unit (s=seconds, m=minutes, h=hours, d=days)
# Examples: 30m, 1h, 24h, 7d
JWT_EXPIRES_IN=24h

# ===========================================
# Backend Configuration
# ===========================================

# Public base URL where the backend API is accessible
# Used for generating callback URLs, webhooks, etc.
# Examples:
#   - https://api.yourdomain.com
#   - http://your-server-ip:3000
BASE_URL=https://api.yourdomain.com

# Secret key for device authentication
# Used to authenticate IoT devices (car wash machines) connecting via MQTT
# Should match the key configured on physical devices
DEVICE_SECRET_KEY=your-device-secret-key-here

# Beam Payment Gateway API URL
# Thai payment gateway for QR code payments
# Production: https://api.beamcheckout.com
# Sandbox: https://api-sandbox.beamcheckout.com
BEAM_API_URL=https://api.beamcheckout.com

# ===========================================
# Frontend Configuration (Nuxt 3)
# ===========================================

# Backend API URL that the frontend will call
# IMPORTANT: This URL must be accessible from user's browser (not internal Docker network)
# For local development: http://localhost:3000
# For production with domain: https://api.yourdomain.com
# For production with IP: http://your-server-ip:3000
NUXT_PUBLIC_API_URL=http://localhost:3000

# Enable debug mode in frontend
# Set to 'true' only for troubleshooting, 'false' for production
NUXT_PUBLIC_DEBUG_ENABLED=false

# Frontend log level
# Options: error, warn, info, debug
NUXT_PUBLIC_LOG_LEVEL=info

# Application name displayed in UI (browser title, headers, etc.)
NUXT_PUBLIC_APP_NAME=CatCar Wash Service

# ===========================================
# Security Checklist Before Deployment
# ===========================================
# [ ] Changed all default passwords above
# [ ] Generated strong JWT_SECRET (64+ characters)
# [ ] Set correct BASE_URL and NUXT_PUBLIC_API_URL
# [ ] Configured firewall to restrict unnecessary ports
# [ ] Enabled HTTPS with valid SSL certificate
# [ ] Backed up this .env.prod file securely (not in git!)
